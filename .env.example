# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/intelligent_chatbox

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# AI Engine Configuration
# Supported providers: built-in, gemini, openai
DEFAULT_AI_PROVIDER=built-in

# External API Keys (Optional - built-in contextual NLP engine runs if not provided)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Application Limits
MAX_CONTEXT_TURNS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
